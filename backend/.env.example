DATABASE_URL=sqlite:///./mortgage.db
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_SIZE=15728640
# Set this when tesseract.exe is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# UPLOADS_DIR=C:\path\to\private\uploads
NVIDIA_API_KEY=your_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Use a Nemotron model enabled for your NVIDIA NIM deployment, for example:
# NVIDIA_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
NVIDIA_USE_JSON_MODE=true
NVIDIA_TIMEOUT_SECONDS=45
NEMOTRON_MAX_INPUT_CHARS=24000
FINANCIAL_TOLERANCE_PERCENT=2
# Demonstration review thresholds only; leave blank to disable.
MAX_DTI=
MAX_LTV=
MIN_CREDIT_SCORE=
MAX_POLICY_UPLOAD_SIZE=10485760
POLICY_UPLOADS_DIR=C:\path\to\private\policy_uploads
POLICY_INDEX_PATH=C:\path\to\private\policy_index.json
POLICY_CHUNK_SIZE=1200
POLICY_CHUNK_OVERLAP=150
POLICY_EMBEDDING_DIMENSIONS=256
POLICY_TOP_K=5
